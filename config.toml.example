# ── crab-dump configuration ────────────────────────────────────────────────
#
# This file uses TOML format. Copy it to `config.toml` and fill in your values.
# Environment variables always override file values — for sensitive data
# (tokens, secrets) prefer env vars; for everything else a file is convenient.
#
# Required fields: database_url, tg_bot_token, tg_chat_id
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
database_url = "postgresql://user:password@host:5432/dbname"

# Telegram bot token from @BotFather.
tg_bot_token = "123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Target chat: numeric id (e.g. -1001234567890 for a channel) or @channelusername.
tg_chat_id = "-1001234567890"

# Optional fields -----------------------------------------------------------

# age X25519 recipient public key (starts with `age1`).
# Omit or comment out for unencrypted dumps.
# age_recipient = "age1..."

# SOCKS5 proxy for Telegram API.
# socks_proxy = "socks5h://127.0.0.1:2080"

# Extra args passed verbatim to pg_dump.
# pg_dump_extra_args = "--format=custom --no-owner"

# Max size of each uploaded part in MiB (default: 49).
# chunk_size_mb = 49

# Directory for temporary chunk files (default: OS temp dir).
# work_dir = "/var/tmp/crab-dump"

# How many databases back up at the same time (default: 4, minimum 1).
# Peak work_dir usage is this many compressed dumps at once; lower it when
# disk, CPU or database load is the constraint. 1 = fully sequential.
# max_parallel_databases = 4

# Multi-server configuration (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Instead of the single `database_url` above, you can declare multiple servers
# using a TOML array. Each server gets its own connection string and optional
# overrides. Servers are backed up in parallel during a single run, up to
# `max_parallel_databases` at a time.
#
# This section takes priority over the single-database fields above.
# When both are present, only [[databases]] is used.
#
# See docs/ADR-0001-multi-database-support.md for design details.

# [[databases]]
# url = "postgresql://user:pass@host1:5432/production_db"
# name = "myapp-prod"
# pg_dump_extra_args = "--exclude-table=sessions --exclude-table=temp_logs"

# [[databases]]
# url = "postgresql://user:pass@host2:5432/analytics"
# name = "analytics-db"
# # Inherits the shared pg_dump_extra_args from above when omitted.

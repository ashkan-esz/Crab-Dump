# ── crab-dump configuration ────────────────────────────────────────────────
#
# This file uses TOML format. Copy it to `config.toml` and fill in your values.
# Environment variables always override file values — for sensitive data
# (tokens, secrets) prefer env vars; for everything else a file is convenient.
#
# Required fields: at least one [[databases]] entry, tg_bot_token, and indexed
# TG_CHAT_ID_N environment variables (chat IDs are environment-only), and
# compression_codec.
# ---------------------------------------------------------------------------

# At least one database entry is required.
# [[databases]]
# url = "postgresql://user:password@host:5432/dbname"
# name = "dbname"

# Telegram bot token from @BotFather.
tg_bot_token = "123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Optional compression: "zstd", "gzip", or "brotli". Omit for raw .dump files.
compression_codec = "zstd"
# Optional codec-native level: zstd default 3, gzip default 6, brotli default 5.
# compression_level = 3
# zstd only; defaults to true. Do not set for gzip or brotli.
# compression_checksum = true

# Telegram destinations are environment-only: set TG_CHAT_ID_0, TG_CHAT_ID_1, …

# Optional fields -----------------------------------------------------------

# age X25519 recipient public key (starts with `age1`).
# Omit or comment out for unencrypted dumps.
# age_recipient = "age1..."

# SOCKS5 proxy for Telegram API.
# socks_proxy = "socks5h://127.0.0.1:2080"

# Dashboard-managed VMess, VLESS, Shadowsocks, and Trojan profiles are stored
# in ./data and configured from the dashboard. SOCKS_PROXY/socks_proxy cannot
# be combined with an active profile.

# Extra args passed verbatim to pg_dump.
# pg_dump_extra_args = "--format=custom --no-owner"

# Max size of each uploaded part in MiB (default: 49).
# chunk_size_mb = 49

# Directory for temporary chunk files (default: OS temp dir).
# work_dir = "/var/tmp/crab-dump"

# How many databases back up at the same time (default: 4, minimum 1).
# Peak work_dir usage is this many compressed dumps at once; lower it when
# disk, CPU or database load is the constraint. 1 = fully sequential.
# max_parallel_databases = 4

# Keep a failed backup's partial chunk files in work_dir for debugging
# (default: false — chunks are deleted as soon as they upload, and a failure
# sweeps whatever is left). Nothing removes kept files later.
# keep_failed_dumps = false

# Built-in scheduler. Omitted (or "0") = one backup cycle, then exit — for an
# external cron job or systemd timer. Set an interval and crab-dump stays
# alive instead: it backs up immediately, then repeats forever, keeping the
# dashboard served in between.
#
# Either a plain interval — seconds, or a number with an `s`/`m`/`h`/`d` suffix,
# minimum 60s, measured from the start of each cycle — or a 5-field crontab
# expression, which aligns to the wall clock and does not back up at startup.
# backup_interval = "6h"
# backup_interval = "0 */4 * * *"   # 00:00, 04:00, 08:00, …

# Upload the active monthly JSONL history file once per matching local date
# while BACKUP_INTERVAL scheduled mode is running. Defaults to 23:59.
# Set to "0" or "" to disable.
# history_upload_schedule = "59 23 * * *"

# Multi-server configuration
# ─────────────────────────────────────────────────────────────────────────────
# Declare one or more servers using a TOML array. Each server gets its own
# connection string and optional overrides. Servers are backed up in parallel up to
# `max_parallel_databases` at a time.
#
# See docs/ADR-0001-multi-database-support.md for design details.

# [[databases]]
# url = "postgresql://user:pass@host1:5432/production_db"
# name = "myapp-prod"
# pg_dump_extra_args = "--exclude-table=sessions --exclude-table=temp_logs"

# [[databases]]
# url = "postgresql://user:pass@host2:5432/analytics"
# name = "analytics-db"
# # Inherits the shared pg_dump_extra_args from above when omitted.

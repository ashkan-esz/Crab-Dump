# Required ---------------------------------------------------------------

# Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Telegram bot token from @BotFather.
TG_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Target chat: numeric id (e.g. -1001234567890 for a channel) or @channelusername.
# The bot must be a member (and, for channels, have "Post Messages" permission).
TG_CHAT_ID=-1001234567890

# Optional --------------------------------------------------------------

# age X25519 recipient public key (starts with `age1`).
# Omit this to upload compressed but NOT encrypted dumps.
# Generate a keypair with: rage-keygen -o identity.txt
# AGE_RECIPIENT=age1...

# SOCKS5 proxy for Telegram API (required if Telegram is blocked in your
# country). Use `socks5h://` to resolve DNS through the proxy (recommended).
# SOCKS_PROXY=socks5h://127.0.0.1:2080

# Extra args passed to pg_dump (default: --format=custom --no-owner).
# If you set --format=plain here, restore with psql instead of pg_restore.
# PG_DUMP_EXTRA_ARGS=--format=custom --no-owner --no-privileges

# Max size of each uploaded part, in MiB. Default 49 (the cloud Telegram
# Bot API caps sendDocument at 50 MiB). Keep below 50.
# CHUNK_SIZE_MB=49

# Directory for temporary chunk files. Defaults to the OS temp dir.
# WORK_DIR=/var/tmp/crab-dump

# Logging verbosity. Default `info`; use `debug` for chunk-by-chunk detail.
# RUST_LOG=info

# Multi-server configuration (indexed env vars)
# Each database gets its own entry prefixed with an index.
# Databases 0 and 1 are backed up in parallel during a single run.
# DATABASE_URL_0=postgresql://user:pass@host1:5432/production_db
# DB_NAME_0=myapp-prod
# DATABASE_URL_1=postgresql://user:pass@host2:5432/analytics
# DB_NAME_1=analytics-db
# PG_DUMP_EXTRA_ARGS_0=--exclude-table=sessions --exclude-table=temp_logs
# The shared PG_DUMP_EXTRA_ARGS is inherited unless overridden per-index.
#
# How many databases dump at the same time. Default 4; must be at least 1.
# Peak WORK_DIR usage is this many compressed dumps at once, so lower it when
# disk, CPU or database load is the constraint. 1 = fully sequential.
# MAX_PARALLEL_DATABASES=4
#
# See docs/ADR-0001-multi-database-support.md for full design details.
